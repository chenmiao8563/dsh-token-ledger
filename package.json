{
  "name": "@chenmiao8563/dsh-token-ledger",
  "version": "1.0.0",
  "description": "Transparent, auditable token accounting for DeepSeek Harness: a restart-safe ledger over the durable session log, a CLI that recomputes it from raw logs and diffs the result, and a bill — by workspace, session, model or provider, exportable as CSV or JSON.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "token-usage",
    "token-accounting",
    "usage-stats",
    "cost-tracking",
    "billing",
    "bill-export",
    "ledger",
    "audit",
    "llm-observability"
  ],
  "license": "MIT",
  "author": "chenmiao8563 <1420647373@qq.com>",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cli": "./lib/cli.js",
    "./ledger": "./lib/ledger.js",
    "./session-log": "./lib/session-log.js",
    "./store": "./lib/store.js",
    "./overview": "./lib/overview.js",
    "./bill": "./lib/bill.js",
    "./csv": "./lib/csv.js",
    "./providers": "./lib/providers.js",
    "./rates": "./lib/rates.js",
    "./rates-service": "./lib/rates-service.js",
    "./vendor-prices": "./lib/vendor-prices.js",
    "./route": "./lib/route.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-token-ledger": "bin/dsh-token-ledger.mjs"
  },
  "files": [
    "lib/",
    "bin/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:single-process": "node --test --experimental-test-isolation=none test/*.test.mjs",
    "verify": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run verify && npm test"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-general": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings-general": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenmiao8563/dsh-token-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/chenmiao8563/dsh-token-ledger/issues"
  },
  "homepage": "https://github.com/chenmiao8563/dsh-token-ledger#readme",
  "publishConfig": {
    "access": "public"
  }
}
